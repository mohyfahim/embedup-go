COPY public.terms_conditions (name, content, "contentId") FROM stdin;
قوانین و مقررات استفاده از پلتفرم پادباکس\n	<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">کاربران عزیز، از اینکه پادباکس را بعنوان همراه هوشمند خانواده خود انتخاب کرده&zwnj;اید، سپاسگزاریم.</span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">پادباکس بعنوان زیست&zwnj;بوم هوشمند در محیط خانه برای تسهیل زندگی دیجیتالی اعضاء خانواده&zwnj;های ایرانی طراحی و تولید شده است و اطمینان می&zwj;&zwnj;دهد محتوایی که بدست هر یک از اعضاء خانواده در سنین مختلف خواهد رسید مطابق با فرهنگ و سبک زندگی ایرانی تهیه شده است.</span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">تمامی محتواهای موجود در پادباکس مطابق با چارچوب&zwnj;ها و قوانین جمهوری اسلامی ایران، قانون حمایت از حقوق مصرف کننده و تجارت الکترونیکی است. پادباکس بعنوان عضو دیجیتالی سوپر&zwnj;پلتفرم سرزمین هوشمند پاد، برای خط و مشی و رسالت اجرایی خود، از <a href="https://ic.pod.ir/%da%a9%d8%aa%d8%a7%d8%a8%d8%ae%d8%a7%d9%86%d9%87/%d8%a7%d9%86%d8%aa%d8%b4%d8%a7%d8%b1%d8%a7%d8%aa-%d9%be%d8%a7%d8%af/26152/">سوپر پلتفرم سرزمین هوشمند پاد</a> (پلتفرم اقتصاد دیجیتالی بانک پاسارگاد) تبعیت می&zwnj;کند. حریم خصوصی، صیانت از داده&zwnj;های کاربران و امنیت اطلاعات مطابق با تعاریف و سیاست&zwnj;هایی که از طریق بانک پاسارگاد تدوین و تهیه شده است بر کل این زیست&zwnj;بوم حاکم است.&nbsp;<a href="https://ic.pod.ir/%DA%A9%D8%AA%D8%A7%D8%A8%D8%AE%D8%A7%D9%86%D9%87/%D8%A7%D9%86%D8%AA%D8%B4%D8%A7%D8%B1%D8%A7%D8%AA-%D9%BE%D8%A7%D8%AF/26152/">[مطالعه خط&zwnj;و&zwnj;مشی پاد]</a></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">بدیهی است که قوانین استفاده از پادباکس مطابق با سیاست&zwnj;های بالادستی و یا استراتژی&zwnj;های کسب&zwnj;و&zwnj;کاری تغییرات خواهد داشت و کاربران ملزم هستند که در زمان&zwnj;های مختلف جهت اطلاع از قوانین و مقررات به صفحه فعلی مراجعه کرده و نسبت به مطالعه و رعایت قوانین اقدام بفرمایند.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>ثبت نام در پادباکس:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">برای استفاده از پادباکس شما باید عضوی از سرزمین هوشمند پاد شوید. با ورود و ثبت نام در پادباکس دنیای جدیدی از خدمات دیجیتالی در حوزه&zwnj;های ده&zwnj;گانه این سرزمین دیجیتالی پیش روی شماست. تنها کافیست شماره موبایل خود را وارد کنید تا کد یکبار مصرف برای شما پیامک شود و با وارد کردن این کد در باکس مربوطه شما عضوی از این سرزمین هوشمند پاد خواهید شد. این بدان معناست که قوانین و مقررات آن را پذیرفته&zwnj;اید.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>قوانین حساب کاربری:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">در پادباکس کاربران تعریف مشخص دارند. از نگاه پادباکس مقصود از کاربر یک انسان است و استفاده یا ثبت&zwnj;نام ربات&zwnj;ها یا دیگر روش&zwnj;های ثبت نام خودکار در پادباکس مجاز شناخته نمی&zwnj;شوند. در حال حاضر کاربران برای استفاده از خدمات پادباکس باید حداقل 18 سال را داشته باشند اما والدین برای کودکان خردسال خود می&zwnj;توانند حساب کاربری ایجاد کنند که در این صورت محتوای مناسب برای سنین زیر 12 سال در اختیارشان قرار می&zwnj;گیرد. هر کاربر مسئول تمامی فعالیت&zwnj;هایی است که در پادباکس انجام می&zwnj;دهد، اعم از درج نظر یا تماشای هر محتوایی که در دسترس ایشان است. دقت بفرمایند، حتی زمانی که این فعالیت&zwnj;ها توسط افرادی غیر از شما که به پنل کاربر شما دسترسی دارند انجام شود. شما اجازه ندارید که این خدمات را در راستای اهداف غیر قانونی و یا غیر مجاز استفاده کنید.</span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>خدمات مالی-بانکی:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">وظیفه انجام خدمات مالی-بانکی در پادباکس بر عهده دستیار پرداخت پادی&zwnj;پی می&zwnj;باشد که قدرت گرفته از حساب دیجیتال بانک پاسارگاد است. انجام خدمات مالی-بانکی بر اساس دستورالعمل&zwnj;های اعلامی از سوی بانک مرکزی از جمله مبارزه با پولشویی است و بر اساس سطوح احراز هویتی که انجام می&zwnj;دهید می&zwnj;توانید به میزان مشخصی تراکنش را در سیستم بانکی به ثبت برسانید. شرایط و قوانین استفاده از پادی&zwnj;پی در بخش مربوطه توضیح داده شده است که بر اساس آن کاربران تا سطوح خاصی می&zwnj;توانند از خدمات مالی بهره&zwnj;مند شوند.</span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">قوانین و مقررات مربوط به &quot;پادی&zwnj;پی&quot;:</span></span></p>\n\n<ul>\n\t<li dir="RTL" style="margin-right:48px; margin-bottom:11px; text-align:right"><span style="direction:rtl"><span style="unicode-bidi:embed">کیف پول پادباکس همان حساب دیجیتال بانک پاسارگاد است.</span></span></li>\n\t<li dir="RTL" style="margin-right:48px; margin-bottom:11px; text-align:right"><span style="direction:rtl"><span style="unicode-bidi:embed">در صورتی که در هنگام انجام تراکنش با خطا مواجه شوید و از حساب شما پول برداشت شود، بصورت خودکار اصلاح حساب انجام خواهد شد و کیف پول دیجیتالی شما شارژ می&zwnj;شود. در صورتی که نیاز به راهنمایی دارید می&zwnj;تواند با مرکز تماس &quot;سرزمین هوشمند پاد&quot; با شماره 02191033000 تماس حاصل بفرمایید.</span></span></li>\n\t<li dir="RTL" style="margin-right:48px; margin-bottom:11px; text-align:right"><span style="direction:rtl"><span style="unicode-bidi:embed">در صورتی که کاربران از محتواهای غیررایگان پادباکس استفاده کنند لازم است آن محتوا را خریداری کنند که برای خرید هر محتوایی شامل&zwnj; فیلم سینمایی، سریال یا اکران در پلتفرم پادباکس از رمز یکبار مصرف استفاده خواهد شد.</span></span></li>\n</ul>\n\n<p dir="RTL" style="margin-right:48px; margin-bottom:11px; text-align:right">&nbsp;</p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>حقوق ناشرین و مالکیت معنوی:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">مالکیت معنوی پلتفرم پادباکس متعلق به شرکت سرزمین هوشمند پاد است و تمامی محتواهای صوتی، تصویری و یا نوشتاری در پادباکس با حفظ حقوق ناشرین در اختیار کاربران قرار گرفته است و مجوزات قانونی را دریافت کرده&zwnj;اند. اشخاص حقیقی و یا حقوقی که در خصوص محتوایی&nbsp; مشخص ادعایی دارند می&zwnj;توانند موارد را از طریق ایمیل <a href="mailto:Support@podbox.ir">Support@podbox.ir</a> پیگیری بفرمایند.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>شرایط و قوانین در حوزه اپلیکیشن و الزامات اقتصادی:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">کاربران حق استفاده نادرست و یا سوء استفاده از پلتفرم پادباکس را ندارند.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px">در صورت تغییر در قوانین و مقررات، برای اخذ تاییدیه کاربر اقدام خواهد شد در این صورت، چنانچه تغییرانی در خدمات ارائه شده در سکوی پادباکس ایجاد شود، در صورت عدم موافقت کاربر، مبلغ باقیمانده اشتراک، به وی برگشت داده می شود.</p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">ترافیک مصرفی کاربران بصورت نیم&zwnj;بها و یا تمام&zwnj;بها است و بر اساس قوانین بالادستی اعمال می&zwnj;شود.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px">هزینه تمامی خدمات پیش از ثبت نام به صورت صریح به کاربر ارايه می گردد و در وبسایت پادباکس قابل رویت است.</p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px">سکوی پادباکس خود را ملزم به رعایت دقیق و کامل دستورالعمل ارتباطات تجاری، دستور العمل عدالت رسانه ای و حفاظت از رقابت و سایر مقررات و دستورالعملهای ساترا می داند.</p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px">تمامی محتوایی که در حال حاضر در اختیار کاریران قرار گرفته است تا پایان مدت اشتراک در اختیار ایشان خواهد بود. چنانچه مطابق قوانین و مقررات مراجع ذی صلاح و دستور ایشان، ضرورت به حذف یا اصلاح محتوا وجود داشته باشد، این موضوع به اطلاع کاربران دارای اشتراک رسانیده خواهد شد.</p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>حریم خصوصی، نحوه نگهداری و امنیت داده&zwnj;ها:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">پلتفرم پادباکس و برند آن بصورت قانونی در اختیار شرکت سرزمین هوشمند پاد می&zwnj;باشد که با سرمایه&zwnj;گذاری بانک پاسارگاد در سوپر پلتفرم پاد توسعه یافته است. مسئول حفظ و نگهداری داده&zwnj;های کاربران و حراست از آنها برعهده پادباکس می&zwnj;باشد. و به کاربران این اطمینان را می&zwnj;دهیم که داده&zwnj;های ذخیره شده در مراکز داده سرزمین هوشمند پاد بصورت کد شده نگهداری می&zwnj;شوند و توسط فایروال&zwnj;های سخت&zwnj;افزاری و نرم&zwnj;افزاری محافظت می&zwnj;شوند. لازم بذکر است اطلاعات هر کاربر تنها برای همان نام کاربری قابل مشاهده است و هیچ کاربر دیگری قادر به مشاهده آن اطلاعات نیست.</span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>توافقنامه سطح خدمات:</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">برای حفظ شان کاربران و با هدف ارائه خدماتی متمایز و درخور، مرکز تماس پادباکس راه&zwnj;اندازی شده است که بصورت 24 ساعته و در طول 7 روز هفته خدمات پشتیبانی را به کاربران ارائه می&zwnj;دهد. برای این منظور کاربران می&zwnj;توانند با شماره تماس 02191033000 تماس حاصل بفرمایند.</span></span></p>\n\n<p dir="RTL" style="margin-top:16px; text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed"><b>قوانین و مقررات دولتی</b></span></span></p>\n\n<p dir="RTL" style="text-align:right; margin-bottom:11px"><span style="direction:rtl"><span style="unicode-bidi:embed">در صورت استفاده نادرست از خدمات پادباکس که با قوانین جمهوری اسلامی ایران مغایرت داشته باشد، پادباکس مجاز است حساب کاربری شما را مسدود کرده و اقدامات قانونی را در دستور کار قرار دهد.</span></span></p>	52228961
\.


